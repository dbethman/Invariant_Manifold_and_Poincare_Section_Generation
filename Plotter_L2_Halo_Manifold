import pickle
import matplotlib.pyplot as plt
import numpy as np

def draw_sphere(ax, x_center, y_center, z_center, radius, color, label):
    """Helper function to draw a 3D sphere representing a celestial body."""
    u, v = np.mgrid[0:2*np.pi:30j, 0:np.pi:20j]
    x = x_center + radius * np.cos(u) * np.sin(v)
    y = y_center + radius * np.sin(u) * np.sin(v)
    z = z_center + radius * np.cos(v)
    ax.plot_surface(x, y, z, color=color, alpha=0.8, label=label)
    
    # Add a proxy artist for the legend
    proxy = plt.Line2D([0], [0], linestyle="none", marker='o', markersize=10, markerfacecolor=color, color=color)
    return proxy

def set_axes_equal(ax, center=None):
    """
    Make axes of 3D plot have equal scale so that spheres appear as spheres,
    cubes as cubes, etc. If 'center' is provided as (x,y,z), the plot will 
    be anchored around that point.
    """
    x_limits = ax.get_xlim3d()
    y_limits = ax.get_ylim3d()
    z_limits = ax.get_zlim3d()

    x_range = abs(x_limits[1] - x_limits[0])
    y_range = abs(y_limits[1] - y_limits[0])
    z_range = abs(z_limits[1] - z_limits[0])

    # Find the maximum range across all three axes to ensure a 1:1:1 aspect ratio
    plot_radius = 0.5 * max([x_range, y_range, z_range])

    if center is not None:
        x_middle, y_middle, z_middle = center
    else:
        x_middle = np.mean(x_limits)
        y_middle = np.mean(y_limits)
        z_middle = np.mean(z_limits)

    ax.set_xlim3d([x_middle - plot_radius, x_middle + plot_radius])
    ax.set_ylim3d([y_middle - plot_radius, y_middle + plot_radius])
    ax.set_zlim3d([z_middle - plot_radius, z_middle + plot_radius])

def plot_manifolds(filename='l2_halo_manifold.pkl'):
    # Load the trajectory data
    with open(filename, 'rb') as file:
        data = pickle.load(file)

    fig = plt.figure(figsize=(10, 8))
    ax = fig.add_subplot(111, projection='3d')

    # Earth-Moon CR3BP Constants
    mu = 0.0121505856  # Earth-Moon mass ratio
    lstar = 384400.0   # Characteristic length (Earth-Moon distance in km)
    
    # Non-dimensional positions
    x_earth = -mu
    x_moon = 1 - mu
    
    # Non-dimensional radii
    r_earth = 6378.0 / lstar
    r_moon = 1900 / lstar
    
    # Distance threshold for filtering (1700 km converted to non-dimensional units)
    min_dist_nd = 1700.0 / lstar
    moon_center = np.array([x_moon, 0.0, 0.0])

    # Plot Earth and Moon
    earth_proxy = draw_sphere(ax, x_earth, 0, 0, r_earth, 'mediumblue', 'Earth')
    moon_proxy = draw_sphere(ax, x_moon, 0, 0, r_moon, 'gray', 'Moon')

    # Plot the main periodic orbit (always the first element in data)
    orbit = np.array(data[0])
    orbit_line, = ax.plot(orbit[:, 0], orbit[:, 1], orbit[:, 2], 
                          color='black', linewidth=2, label='Periodic Orbit (L2 Halo)')

    has_unstable = False
    has_stable = False

    # Iterate through all subsequent trajectories dynamically
    for traj in data[1:]:
        traj_arr = np.array(traj)
        
        # Calculate distances from every point in this trajectory to the Moon's center
        distances_to_moon = np.linalg.norm(traj_arr[:, 0:3] - moon_center, axis=1)
        
        # Skip this trajectory completely if it gets within 1700 km of the Moon
        if np.any(distances_to_moon < min_dist_nd):
            continue
        
        # Determine integration direction by comparing final time to initial time (index 6)
        t_initial = traj_arr[0, 6]
        t_final = traj_arr[-1, 6]
        
        if t_final > t_initial:
            # Forward in time -> Unstable Manifold
            color = 'red'
            has_unstable = True
        else:
            # Backward in time -> Stable Manifold
            color = 'blue'
            has_stable = True

        ax.plot(traj_arr[:, 0], traj_arr[:, 1], traj_arr[:, 2], 
                color=color, linewidth=0.5, alpha=0.6)

    # Plot formatting
    ax.set_title("L2 Halo Orbit and Invariant Manifolds (Moon-Centered)", fontsize=14)
    ax.set_xlabel("X (Non-dimensional)")
    ax.set_ylabel("Y (Non-dimensional)")
    ax.set_zlabel("Z (Non-dimensional)")
    
    # Force the axes to have an equal 1:1:1 physical scale and center exactly on the Moon
    set_axes_equal(ax, center=(x_moon, 0.0, 0.0))
    
    # Set the bounding box aspect ratio to be perfectly cubic
    ax.set_box_aspect([1, 1, 1]) 

    # Construct legend manually
    legend_handles = [earth_proxy, moon_proxy, orbit_line]
    legend_labels = ['Earth', 'Moon', 'L2 Halo Orbit']
    
    if has_unstable:
        legend_handles.append(plt.Line2D([0], [0], color='red', linewidth=1))
        legend_labels.append('Unstable Manifold')
    if has_stable:
        legend_handles.append(plt.Line2D([0], [0], color='blue', linewidth=1))
        legend_labels.append('Stable Manifold')

    ax.legend(legend_handles, legend_labels, loc='upper right')

    plt.tight_layout()
    plt.show()

def plot_poincare_3d(filename='l2_halo_manifold.pkl'):
    # Load the trajectory data
    with open(filename, 'rb') as file:
        data = pickle.load(file)

    # Earth-Moon CR3BP Constants
    mu = 0.0121505856
    lstar = 384400.0   # Characteristic length (Earth-Moon distance in km)
    x_earth = -mu

    # GEO Orbit Radius
    r_geo_km = 42164.0 # Distance from Earth's center in km
    r_geo_nd = r_geo_km / lstar # Non-dimensional GEO radius

    # Lists to store the interpolated crossing points
    unstable_y, unstable_z, unstable_v = [], [], []
    stable_y, stable_z, stable_v = [], [], []

    # Iterate through all trajectories (skipping the main orbit at index 0)
    for traj in data[1:]:
        traj_arr = np.array(traj)
        
        # Determine manifold type based on time integration direction
        t_initial = traj_arr[0, 6]
        t_final = traj_arr[-1, 6]
        is_unstable = (t_final > t_initial)

        # X positions relative to the Earth's X coordinate
        x_rel = traj_arr[:, 0] - x_earth
        
        # Find indices where the trajectory crosses the Earth's X-plane (sign change)
        crossings = np.where(np.diff(np.sign(x_rel)))[0]
        
        for idx in crossings:
            # Linear interpolation to find exact positions and velocities at X = -mu
            x1, x2 = traj_arr[idx, 0], traj_arr[idx+1, 0]
            y1, y2 = traj_arr[idx, 1], traj_arr[idx+1, 1]
            z1, z2 = traj_arr[idx, 2], traj_arr[idx+1, 2]
            
            vx1, vx2 = traj_arr[idx, 3], traj_arr[idx+1, 3]
            vy1, vy2 = traj_arr[idx, 4], traj_arr[idx+1, 4]
            vz1, vz2 = traj_arr[idx, 5], traj_arr[idx+1, 5]
            
            # Interpolation fraction
            fraction = (x_earth - x1) / (x2 - x1)
            
            # Interpolated coordinates
            y_cross = y1 + fraction * (y2 - y1)
            z_cross = z1 + fraction * (z2 - z1)
            
            # Interpolated velocities
            vx_cross = vx1 + fraction * (vx2 - vx1)
            vy_cross = vy1 + fraction * (vy2 - vy1)
            vz_cross = vz1 + fraction * (vz2 - vz1)
            
            # Non-dimensional speed magnitude
            v_cross = np.sqrt(vx_cross**2 + vy_cross**2 + vz_cross**2)
            
            if is_unstable:
                unstable_y.append(y_cross)
                unstable_z.append(z_cross)
                unstable_v.append(v_cross)
            else:
                stable_y.append(y_cross)
                stable_z.append(z_cross)
                stable_v.append(v_cross)

    # Create the 3D plot
    fig = plt.figure(figsize=(10, 8))
    ax = fig.add_subplot(111, projection='3d')

    if unstable_y:
        ax.scatter(unstable_y, unstable_z, unstable_v, 
                   color='red', s=10, alpha=0.7, label='Unstable Manifold')
    
    if stable_y:
        ax.scatter(stable_y, stable_z, stable_v, 
                   color='blue', s=10, alpha=0.7, label='Stable Manifold')

    # Add the Earth's center footprint at V=0
    ax.scatter([0], [0], [0], color='mediumblue', s=100, marker='X', label='Earth Center')

    # Draw the GEO Orbit ring footprint on the V=0 plane
    theta = np.linspace(0, 2*np.pi, 200)
    y_geo = r_geo_nd * np.cos(theta)
    z_geo = r_geo_nd * np.sin(theta)
    v_geo = np.zeros_like(y_geo)  # Placed at V=0 as a spatial reference
    ax.plot(y_geo, z_geo, v_geo, color='green', linestyle='--', linewidth=1.5, 
            label=f'GEO Orbit Footprint (~{r_geo_km} km)')

    # Plot formatting
    ax.set_title(r"3D Poincaré Section at Earth's X-Coordinate ($X = -\mu$)", fontsize=14)
    ax.set_xlabel("Y (Non-dimensional)")
    ax.set_ylabel("Z (Non-dimensional)")
    ax.set_zlabel("Speed (Non-dimensional)")
    
    ax.legend(loc='upper right')

    plt.tight_layout()
    plt.show()

