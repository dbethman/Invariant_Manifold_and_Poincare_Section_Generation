import pickle
from Manifold_Functions import ManifoldSolver


def main():
    # Initialize the CR3BP environment
    solver = ManifoldSolver()

    

    initial_guess =  [0.820150, 0.0, 0.0, 0.0, 0.149200, 0.0, 0.0]
    tf_guess = 2.75
    
    
    output_filename = 'l1_unstable_manifold.pkl'


    dataL1 = solver.generate_manifolds(initial_guess, tf_guess, manifold_num = 300, step_size=1e-3, multiplier = 3, stable=False, unstable=True, pos=True, neg=False)





    
    # Save the data
    with open(output_filename, 'wb') as file:
        pickle.dump(dataL1, file)
        

    print(f"Successfully saved {len(dataL1)} orbits to {output_filename}.")

if __name__ == '__main__':
    main()