import pickle
from Manifold_Functions import ManifoldSolver


def main():
    # Initialize the CR3BP environment
    solver = ManifoldSolver()

    

    initial_guess =  [0.8234, 0.0, 0.0, 0.0, .1263, 0.0, 0.0] 
    tf_guess = 2.74
    
    
    output_filename = 'l1_manifold.pkl'


    data = solver.generate_manifolds(initial_guess, tf_guess, manifold_num = 200, step_size=1e-3, multiplier = 2)

    # Save the data
    with open(output_filename, 'wb') as file:
        pickle.dump(data, file)

    print(f"Successfully saved {len(data)} orbits to {output_filename}.")

if __name__ == '__main__':
    main()